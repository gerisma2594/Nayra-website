<!DOCTYPE html>

<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>كانفا برو والطباعة — المستوى الثاني — NAYRA نيرا</title>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;0,900;1,400&family=Cairo:wght@300;400;600;700;900&display=swap" rel="stylesheet"/>
<style>
  * { margin:0; padding:0; box-sizing:border-box; }
  body { font-family:'Cairo',sans-serif; background:#F6F1EB; color:#2F2F2F; overflow-x:hidden; direction:rtl; }

/* ── NAV ── */
nav {
position:fixed; top:0; left:0; right:0; z-index:100;
padding:18px 48px; display:flex; align-items:center; justify-content:space-between;
background:rgba(246,241,235,0.92); backdrop-filter:blur(16px);
border-bottom:1px solid rgba(212,175,127,0.2);
}
.nav-logo { font-family:‘Playfair Display’,serif; font-size:24px; font-weight:900; color:#4F6F6A; letter-spacing:3px; text-decoration:none; }
.nav-logo span { font-family:‘Cairo’,sans-serif; font-size:14px; font-weight:600; color:#D4AF7F; margin-right:6px; }
.nav-links { display:flex; gap:22px; list-style:none; }
.nav-links a { font-size:13px; font-weight:600; color:#2F2F2F; text-decoration:none; transition:color 0.3s; }
.nav-links a:hover, .nav-links a.active { color:#4F6F6A; }
@media(max-width:768px){ .nav-links{display:none;} nav{padding:16px 24px;} }

/* ── HERO ── */
.hero {
min-height:100vh; padding:120px 48px 80px;
display:flex; align-items:center;
background-color:#1a1a1a;
background-image:
radial-gradient(ellipse 60% 50% at 90% 40%, rgba(212,175,127,0.12) 0%, transparent 60%),
radial-gradient(ellipse 40% 60% at 10% 80%, rgba(232,207,199,0.08) 0%, transparent 60%);
position:relative; overflow:hidden;
}
/* Printer lines decoration */
.hero::before {
content:’’;
position:absolute; top:0; left:0; right:0;
height:4px;
background:repeating-linear-gradient(90deg, #D4AF7F 0px, #D4AF7F 40px, transparent 40px, transparent 60px);
opacity:0.3;
}
.float-el { position:absolute; z-index:0; opacity:0.05; animation:floatEl 8s ease-in-out infinite; }
.f1{top:15%;right:4%;font-size:80px;animation-delay:0s;}
.f2{bottom:20%;left:4%;font-size:60px;animation-delay:3s;}
.f3{top:50%;right:20%;font-size:40px;animation-delay:1.5s;}
@keyframes floatEl{0%,100%{transform:translateY(0);}50%{transform:translateY(-18px);}}

.hero-inner { max-width:1100px; margin:0 auto; display:grid; grid-template-columns:1.2fr 1fr; gap:80px; align-items:center; position:relative; z-index:1; }
@media(max-width:768px){ .hero-inner{grid-template-columns:1fr; gap:40px;} .hero{padding:120px 24px 80px;} }

.level-badge {
display:inline-flex; align-items:center; gap:10px;
background:rgba(212,175,127,0.12); border:1px solid rgba(212,175,127,0.35);
padding:8px 20px; border-radius:50px; margin-bottom:12px;
font-size:12px; font-weight:700; letter-spacing:2px; color:#D4AF7F; text-transform:uppercase;
}
.prev-badge {
display:inline-flex; align-items:center; gap:8px;
background:rgba(79,111,106,0.15); border:1px solid rgba(79,111,106,0.3);
padding:6px 16px; border-radius:50px; margin-bottom:24px;
font-size:12px; font-weight:600; color:#8db5b0;
}
.hero h1 { font-family:‘Playfair Display’,serif; font-size:clamp(34px,5vw,62px); font-weight:900; color:#F6F1EB; line-height:1.1; margin-bottom:20px; }
.hero h1 em { font-style:italic; color:#D4AF7F; }
.hero h1 span { color:#E8CFC7; }
.hero-desc { font-size:16px; color:rgba(246,241,235,0.65); line-height:2; margin-bottom:36px; max-width:520px; }

.hero-stats { display:flex; gap:28px; margin-bottom:40px; flex-wrap:wrap; }
.stat .num { font-family:‘Playfair Display’,serif; font-size:26px; font-weight:900; color:#D4AF7F; display:block; }
.stat .lbl { font-size:11px; color:rgba(246,241,235,0.45); font-weight:600; letter-spacing:1px; }

.hero-btns { display:flex; gap:14px; flex-wrap:wrap; }
.btn-gold { background:linear-gradient(135deg,#D4AF7F,#c49a60); color:#2F2F2F; padding:16px 36px; border-radius:50px; font-family:‘Cairo’,sans-serif; font-size:15px; font-weight:700; text-decoration:none; display:inline-block; transition:all 0.3s; box-shadow:0 8px 30px rgba(212,175,127,0.3); border:none; cursor:pointer; }
.btn-gold:hover { transform:translateY(-3px); box-shadow:0 14px 40px rgba(212,175,127,0.45); }
.btn-outline-light { background:transparent; color:#F6F1EB; padding:16px 36px; border-radius:50px; font-family:‘Cairo’,sans-serif; font-size:15px; font-weight:700; text-decoration:none; display:inline-block; border:1.5px solid rgba(246,241,235,0.2); transition:all 0.3s; }
.btn-outline-light:hover { background:rgba(246,241,235,0.06); border-color:rgba(246,241,235,0.45); }

/* Printer mockup */
.printer-mockup {
background:linear-gradient(145deg,#2a2a2a,#1a1a1a);
border-radius:20px; padding:28px;
border:1px solid rgba(212,175,127,0.15);
box-shadow:0 30px 80px rgba(0,0,0,0.5);
position:relative;
}
.printer-body {
background:linear-gradient(145deg,#e8e4de,#d4cfc8);
border-radius:14px; padding:20px;
margin-bottom:16px; text-align:center;
position:relative; overflow:hidden;
}
.printer-slot {
background:#2a2a2a; height:8px; border-radius:4px;
margin-bottom:12px; position:relative; overflow:hidden;
}
.printer-slot::after {
content:’’; position:absolute; top:0; left:-100%;
width:60%; height:100%;
background:linear-gradient(90deg,transparent,rgba(212,175,127,0.6),transparent);
animation:printLine 2s ease-in-out infinite;
}
@keyframes printLine { 0%{left:-60%;} 100%{left:110%;} }
.printer-icon { font-size:48px; margin-bottom:8px; display:block; }
.printer-label { font-size:11px; font-weight:700; color:#8a8076; letter-spacing:2px; text-transform:uppercase; }

.print-output {
display:flex; flex-direction:column; gap:8px;
}
.print-card {
background:linear-gradient(135deg,#F6F1EB,#E8CFC7);
border-radius:8px; padding:12px 16px;
display:flex; align-items:center; justify-content:space-between;
font-size:13px; font-weight:700; color:#4F6F6A;
animation:slideFromPrinter 0.5s ease both;
}
.print-card:nth-child(1){animation-delay:0.2s;}
.print-card:nth-child(2){animation-delay:0.4s;}
.print-card:nth-child(3){animation-delay:0.6s;}
@keyframes slideFromPrinter{from{opacity:0;transform:translateY(-8px);}to{opacity:1;transform:translateY(0);}}
.print-card .tag { font-size:10px; background:rgba(79,111,106,0.12); color:#4F6F6A; padding:3px 10px; border-radius:20px; font-weight:700; }

/* ── WELCOME ── */
.welcome { padding:100px 48px; background:#FFFFFF; }
.welcome-inner { max-width:1000px; margin:0 auto; display:grid; grid-template-columns:1fr 1fr; gap:64px; align-items:center; }
@media(max-width:768px){ .welcome-inner{grid-template-columns:1fr; gap:40px;} .welcome{padding:80px 24px;} }
.section-label { font-size:11px; font-weight:700; letter-spacing:3px; text-transform:uppercase; color:#D4AF7F; margin-bottom:16px; display:block; }
.section-title { font-family:‘Playfair Display’,serif; font-size:clamp(26px,4vw,42px); font-weight:900; color:#2F2F2F; line-height:1.2; margin-bottom:16px; }
.section-title em { font-style:italic; color:#4F6F6A; }
.section-desc { font-size:15px; color:#4F6F6A; line-height:2; }

.welcome-points { display:flex; flex-direction:column; gap:16px; margin-top:28px; }
.wp { display:flex; gap:14px; align-items:flex-start; }
.wp-icon { width:40px; height:40px; border-radius:10px; display:flex; align-items:center; justify-content:center; font-size:18px; flex-shrink:0; }
.wp-icon-rose { background:rgba(232,207,199,0.3); }
.wp-icon-sage { background:rgba(79,111,106,0.1); }
.wp-icon-gold { background:rgba(212,175,127,0.15); }
.wp-text strong { display:block; font-size:14px; font-weight:700; color:#2F2F2F; margin-bottom:3px; }
.wp-text span { font-size:13px; color:#4F6F6A; line-height:1.6; }

.tools-preview { background:#F6F1EB; border-radius:20px; padding:28px; }
.tools-preview h4 { font-size:13px; font-weight:700; letter-spacing:2px; color:#D4AF7F; text-transform:uppercase; margin-bottom:20px; }
.tool-list { display:flex; flex-direction:column; gap:12px; }
.tool-item { display:flex; align-items:center; gap:12px; padding:12px 16px; background:#FFFFFF; border-radius:10px; border:1px solid rgba(212,175,127,0.15); }
.tool-item .ti-icon { font-size:20px; }
.tool-item .ti-text strong { display:block; font-size:13px; font-weight:700; color:#2F2F2F; }
.tool-item .ti-text span { font-size:12px; color:#B8A89F; }

/* ── CURRICULUM ── */
.curriculum { padding:100px 48px; background:#F6F1EB; }
.curriculum-inner { max-width:1100px; margin:0 auto; }

.modules { display:flex; flex-direction:column; gap:24px; margin-top:56px; }

.module {
background:#FFFFFF; border-radius:22px; overflow:hidden;
border:1.5px solid rgba(212,175,127,0.15);
transition:box-shadow 0.3s, transform 0.3s;
}
.module:hover { box-shadow:0 12px 50px rgba(79,111,106,0.1); transform:translateY(-2px); }

.mod-head {
display:flex; align-items:center; gap:20px;
padding:26px 32px;
border-bottom:1px solid rgba(212,175,127,0.12);
}
.mod-num {
width:52px; height:52px; border-radius:16px; flex-shrink:0;
display:flex; align-items:center; justify-content:center;
font-family:‘Playfair Display’,serif; font-size:18px; font-weight:900;
}
.mod-info { flex:1; }
.mod-info h3 { font-family:‘Playfair Display’,serif; font-size:20px; font-weight:700; color:#2F2F2F; margin-bottom:5px; }
.mod-meta { font-size:12px; font-weight:700; letter-spacing:1.5px; text-transform:uppercase; }
.mod-right { display:flex; flex-direction:column; align-items:flex-end; gap:6px; flex-shrink:0; }
.mod-duration { font-size:12px; color:#B8A89F; font-weight:600; }
.mod-tag { font-size:10px; font-weight:700; padding:4px 12px; border-radius:20px; letter-spacing:1px; white-space:nowrap; }

/* color themes */
.theme-welcome .mod-num { background:linear-gradient(135deg,#4F6F6A,#3a5450); color:#F6F1EB; }
.theme-welcome .mod-meta { color:#4F6F6A; }
.theme-welcome .mod-tag { background:rgba(79,111,106,0.1); color:#4F6F6A; }

.theme-print .mod-num { background:linear-gradient(135deg,#2F2F2F,#1a1a1a); color:#D4AF7F; }
.theme-print .mod-meta { color:#B8A89F; }
.theme-print .mod-tag { background:#2F2F2F; color:#D4AF7F; }

.theme-rose .mod-num { background:linear-gradient(135deg,#E8CFC7,#D6A6A0); color:#2F2F2F; }
.theme-rose .mod-meta { color:#D6A6A0; }
.theme-rose .mod-tag { background:rgba(232,207,199,0.35); color:#C4845A; }

.theme-gold .mod-num { background:linear-gradient(135deg,#D4AF7F,#c49a60); color:#2F2F2F; }
.theme-gold .mod-meta { color:#A07840; }
.theme-gold .mod-tag { background:rgba(212,175,127,0.2); color:#A07840; }

.theme-sage .mod-num { background:linear-gradient(135deg,#4F6F6A,#6a9490); color:#F6F1EB; }
.theme-sage .mod-meta { color:#4F6F6A; }
.theme-sage .mod-tag { background:rgba(79,111,106,0.1); color:#4F6F6A; }

.theme-special .mod-num { background:linear-gradient(135deg,#D4AF7F,#4F6F6A); color:#F6F1EB; }
.theme-special .mod-meta { color:#D4AF7F; }
.theme-special .mod-tag { background:linear-gradient(135deg,rgba(212,175,127,0.2),rgba(79,111,106,0.1)); color:#A07840; }

.mod-body { padding:28px 32px; }
@media(max-width:600px){ .mod-head{padding:20px;} .mod-body{padding:20px;} }

/* PHASE system */
.phases { display:flex; flex-direction:column; gap:0; }
.phase { position:relative; }
.phase:not(:last-child)::after {
content:‘↓’; position:absolute;
right:24px; bottom:-18px; z-index:2;
font-size:18px; color:#D4AF7F;
width:36px; height:36px; background:#FFFFFF;
border-radius:50%; display:flex; align-items:center; justify-content:center;
border:1.5px solid rgba(212,175,127,0.3);
line-height:36px; text-align:center;
}
.phase-block {
display:flex; gap:0; margin-bottom:24px;
border-radius:14px; overflow:hidden;
border:1px solid rgba(212,175,127,0.15);
}
.phase-label {
writing-mode:vertical-rl; text-orientation:mixed;
padding:20px 14px;
font-size:11px; font-weight:700; letter-spacing:3px; text-transform:uppercase;
display:flex; align-items:center; justify-content:center; flex-shrink:0;
min-width:48px;
}
.phase-design .phase-label { background:rgba(79,111,106,0.1); color:#4F6F6A; }
.phase-print .phase-label { background:#2F2F2F; color:#D4AF7F; }
.phase-cut .phase-label { background:rgba(232,207,199,0.3); color:#C4845A; }
.phase-gift .phase-label { background:rgba(212,175,127,0.15); color:#A07840; }

.phase-content { padding:16px 20px; flex:1; }
.phase-content h4 { font-size:15px; font-weight:700; color:#2F2F2F; margin-bottom:8px; }
.phase-content ul { list-style:none; display:flex; flex-direction:column; gap:6px; }
.phase-content ul li { font-size:13px; color:#4F6F6A; line-height:1.6; display:flex; gap:8px; align-items:flex-start; }
.phase-content ul li::before { content:‘✦’; color:#D4AF7F; font-size:10px; flex-shrink:0; margin-top:4px; }

/* lessons */
.lessons { display:flex; flex-direction:column; gap:12px; }
.lesson { display:flex; align-items:flex-start; gap:14px; padding:14px 18px; border-radius:12px; background:#F6F1EB; }
.lesson-icon { font-size:20px; flex-shrink:0; margin-top:2px; }
.lesson-content { flex:1; }
.lesson-content strong { display:block; font-size:14px; font-weight:700; color:#2F2F2F; margin-bottom:5px; }
.lesson-content p { font-size:13px; color:#4F6F6A; line-height:1.7; }
.ltags { display:flex; gap:6px; margin-top:8px; flex-wrap:wrap; }
.ltag { font-size:10px; font-weight:700; padding:3px 10px; border-radius:20px; letter-spacing:0.5px; }
.lt-practice { background:#e8f5e9; color:#2e7d32; }
.lt-theory { background:#e3f2fd; color:#1565c0; }
.lt-tool { background:rgba(212,175,127,0.2); color:#A07840; }
.lt-business { background:rgba(79,111,106,0.1); color:#4F6F6A; }
.lt-warning { background:#fff3e0; color:#e65100; }
.lt-bonus { background:#f3e5f5; color:#6a1b9a; }

/* models grid */
.models-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:16px; margin-top:4px; }
@media(max-width:500px){ .models-grid{grid-template-columns:1fr;} }
.model-card { border-radius:14px; padding:20px; text-align:center; border:1.5px solid transparent; transition:all 0.3s; }
.model-card:hover { transform:translateY(-4px); }
.mc-1 { background:rgba(232,207,199,0.2); border-color:rgba(232,207,199,0.4); }
.mc-2 { background:rgba(79,111,106,0.08); border-color:rgba(79,111,106,0.2); }
.mc-3 { background:rgba(212,175,127,0.12); border-color:rgba(212,175,127,0.3); }
.model-card .icon { font-size:28px; margin-bottom:10px; display:block; }
.model-card h4 { font-size:14px; font-weight:700; color:#2F2F2F; margin-bottom:6px; }
.model-card p { font-size:12px; color:#4F6F6A; line-height:1.6; }

/* pricing table */
.pricing-table { width:100%; border-collapse:collapse; margin-top:8px; }
.pricing-table th { background:#2F2F2F; color:#D4AF7F; padding:12px 16px; font-size:13px; font-weight:700; text-align:right; }
.pricing-table td { padding:12px 16px; font-size:13px; color:#2F2F2F; border-bottom:1px solid rgba(212,175,127,0.1); }
.pricing-table tr:nth-child(even) td { background:rgba(212,175,127,0.05); }
.pricing-table tr:last-child td { border-bottom:none; }
.price-highlight { color:#4F6F6A; font-weight:700; }
.price-range { font-size:12px; color:#B8A89F; }

/* ── OUTCOMES ── */
.outcomes { padding:100px 48px; background:#2F2F2F; }
.outcomes-inner { max-width:1100px; margin:0 auto; }
.outcomes-inner .section-label { color:#D4AF7F; }
.outcomes-inner .section-title { color:#F6F1EB; margin-bottom:16px; }
.outcomes-inner .section-title em { color:#E8CFC7; }
.outcomes-inner .section-desc { color:rgba(246,241,235,0.55); margin-bottom:56px; }
.outcomes-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(220px,1fr)); gap:18px; }
.oc {
border-radius:18px; padding:28px 24px;
border:1px solid rgba(246,241,235,0.07); transition:all 0.3s;
}
.oc:hover { transform:translateY(-4px); border-color:rgba(212,175,127,0.2); }
.oc-1{background:rgba(232,207,199,0.07);}
.oc-2{background:rgba(79,111,106,0.1);}
.oc-3{background:rgba(212,175,127,0.07);}
.oc-4{background:rgba(214,166,160,0.07);}
.oc-5{background:rgba(246,241,235,0.04);}
.oc .icon { font-size:34px; margin-bottom:16px; display:block; }
.oc h4 { font-family:‘Playfair Display’,serif; font-size:18px; color:#F6F1EB; margin-bottom:8px; font-weight:700; }
.oc p { font-size:13px; color:rgba(246,241,235,0.55); line-height:1.8; }

/* ── REGISTER ── */
.register-section {
padding:100px 48px;
background:linear-gradient(135deg,#F6F1EB 0%,#EDE7DF 60%,#E8CFC7 100%);
text-align:center; position:relative; overflow:hidden;
}
.register-section::before {
content:‘🖨️’; position:absolute; font-size:300px;
opacity:0.03; top:-40px; left:50%; transform:translateX(-50%);
pointer-events:none;
}
.register-inner { max-width:660px; margin:0 auto; position:relative; z-index:1; }
.register-inner .section-label { color:#A07840; }
.register-inner h2 { font-family:‘Playfair Display’,serif; font-size:clamp(26px,4vw,44px); font-weight:900; color:#2F2F2F; margin-bottom:16px; line-height:1.2; }
.register-inner h2 em { font-style:italic; color:#4F6F6A; }
.register-inner > p { font-size:16px; color:#4F6F6A; line-height:1.8; margin-bottom:44px; }

.reg-form { background:#FFFFFF; border-radius:24px; padding:40px; box-shadow:0 20px 60px rgba(79,111,106,0.1); border:1px solid rgba(212,175,127,0.2); display:flex; flex-direction:column; gap:16px; text-align:right; }
.form-row { display:grid; grid-template-columns:1fr 1fr; gap:16px; }
@media(max-width:500px){ .form-row{grid-template-columns:1fr;} }
.fg { display:flex; flex-direction:column; gap:8px; }
.fg label { font-size:13px; font-weight:700; color:#2F2F2F; }
.fg input, .fg select { padding:14px 18px; border-radius:12px; border:1.5px solid rgba(79,111,106,0.15); background:#F6F1EB; font-family:‘Cairo’,sans-serif; font-size:14px; color:#2F2F2F; outline:none; transition:border-color 0.3s; direction:rtl; }
.fg input:focus, .fg select:focus { border-color:#4F6F6A; background:#FFFFFF; }
.fg input::placeholder { color:#B8A89F; }
.btn-register { background:linear-gradient(135deg,#2F2F2F,#1a1a1a); color:#D4AF7F; padding:18px; border-radius:14px; font-family:‘Cairo’,sans-serif; font-size:16px; font-weight:700; border:none; cursor:pointer; letter-spacing:1px; transition:all 0.3s; box-shadow:0 8px 30px rgba(0,0,0,0.2); margin-top:8px; }
.btn-register:hover { transform:translateY(-2px); box-shadow:0 14px 40px rgba(0,0,0,0.3); }
.form-note { font-size:12px; color:#B8A89F; text-align:center; }

/* ── FOOTER ── */
footer { background:#2F2F2F; padding:48px; text-align:center; border-top:1px solid rgba(255,255,255,0.06); }
.footer-logo { font-family:‘Playfair Display’,serif; font-size:28px; font-weight:900; color:#4F6F6A; letter-spacing:5px; margin-bottom:6px; }
.footer-tagline { font-size:12px; color:#D4AF7F; letter-spacing:4px; margin-bottom:28px; }
.footer-social { display:flex; gap:20px; justify-content:center; margin-bottom:28px; }
.social-btn { width:44px; height:44px; border-radius:50%; background:rgba(255,255,255,0.06); border:1px solid rgba(255,255,255,0.1); display:flex; align-items:center; justify-content:center; font-size:18px; text-decoration:none; transition:all 0.3s; }
.social-btn:hover { background:rgba(212,175,127,0.15); border-color:rgba(212,175,127,0.4); }
.footer-nav { display:flex; gap:24px; justify-content:center; flex-wrap:wrap; margin-bottom:28px; }
.footer-nav a { font-size:13px; font-weight:600; color:rgba(246,241,235,0.4); text-decoration:none; transition:color 0.3s; }
.footer-nav a:hover { color:#D4AF7F; }
